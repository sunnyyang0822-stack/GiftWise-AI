# 实例上由 root 保存为 /etc/giftwise/server.env，权限 0600；禁止提交真实值。
# systemd 读取此文件，应用不会自动读取 .env。
GW_MODE=llm
GIFTWISE_RETRIEVAL=domestic
GIFTWISE_INTAKE_PARSE=1
GIFTWISE_IMAGE_GENERATION=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
IMAGE_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_OUTPUT_RETRIES=1
LLM_MAX_TOKENS=16384
LLM_PARSE_MAX_TOKENS=8192
LLM_TEMPERATURE=0.4
# LLM_CALL_BUDGET 不填空值；省略时为代码默认不限制。它是调用次数而非金额限额。
# GW_HOST/GW_PORT/数据库及账本路径由 launch.mjs 固定，避免读入演示配置。
