# 候选 Dockerfile（**仅供评审，不是仓库里的 `deploy/Dockerfile`**）
#
# 目的：修独立审计第 ③ 条 —— 交付镜像 `/app` 只有 3 个文件，不含可观测入口
#      （`deploy/observable_server.py` / `deploy/observability.py`），
#      因此"镜像是否能跑可观测入口"这件事在镜像内根本不成立。
#
# 与 `deploy/Dockerfile` 的差异**只有 2 行 COPY**（下面标了 ← 新增）：
#      CMD 仍然保持 `python -m deploy.server`（不改默认入口行为）。
# 若要同时把可观测入口设为镜像默认入口，把最后一行 CMD 换成
#      CMD ["python", "-m", "deploy.observable_server"]
# 即可；两件事可以分开决定。
#
# 复现：
#   docker build --no-cache -t giftwise-validator:candidate-observable -f deploy/evidence/candidate-Dockerfile-observable .
#   python deploy/evidence/image_source_parity_check.py giftwise-validator:candidate-observable

FROM python:3.12-slim

# GIFTWISE_BIND 显式固定为 0.0.0.0：容器内必须监听所有接口，端口映射 (-p) 才能生效。
# 服务端源码默认值也是 0.0.0.0，这里写明是为了避免日后把默认值改成 127.0.0.1 时
# 静默打断容器发布（HEALTHCHECK 走回环，仍会通过，问题只在外部访问时才暴露）。
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GIFTWISE_PORT=8000 \
    GIFTWISE_BIND=0.0.0.0

WORKDIR /app
COPY validator /app/validator
COPY deploy/server.py /app/deploy/server.py
# ← 新增（可观测入口的两份实现）：
COPY deploy/observability.py /app/deploy/observability.py
COPY deploy/observable_server.py /app/deploy/observable_server.py

RUN useradd --create-home --uid 10001 giftwise \
    && chown -R giftwise:giftwise /app
USER giftwise

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
CMD ["python", "-m", "deploy.server"]
