{"step":"run-demo","value":{"meta":{"csrfPresent":true,"csrfCookieName":"__Host-csrf_token"},"runs":[{"label":"demo_forbidden_term_chocolate","expect":"N2 真实生成 → N3 校验；若含「巧克力」则 N4[repairable] → N5 真实修订 → N6；全通过则 N7a/End A","startedAtLocal":"2026-10-30T15:06:48.882Z","httpStatus":200,"contentType":"text/event-stream; charset=utf-8","elapsedMs":5469,"sseChars":53144,"sse":"event: ping\n\ndata: {\"event\":\"workflow_started\",\"workflow_run_id\":\"fcc5419a-98b9-40d4-bb83-29c8b01f6620\",\"task_id\":\"f3b2bcb1-5dee-4a5a-8dad-29fc8438b5e6\",\"data\":{\"id\":\"fcc5419a-98b9-40d4-bb83-29c8b01f6620\",\"workflow_id\":\"095b12b9-6cea-48b1-aa47-88473b91f30d\",\"inputs\":{\"intake_json\":\"{\\n  \\\"recipient_relation\\\": \\\"pursuit\\\",\\n  \\\"closeness\\\": \\\"limited\\\",\\n  \\\"occasion\\\": \\\"birthday\\\",\\n  \\\"budget_amount\\\": \\\"200.00\\\",\\n  \\\"currency\\\": \\\"CNY\\\",\\n  \\\"deadline_days\\\": 2,\\n  \\\"interests\\\": [\\n    \\\"coffee_food\\\",\\n    \\\"design_art\\\"\\n  ],\\n  \\\"interest_confidence\\\": {\\n    \\\"coffee_food\\\": \\\"confirmed\\\",\\n    \\\"design_art\\\": \\\"inferred\\\"\\n  },\\n  \\\"gift_styles\\\": [\\n    \\\"practical\\\",\\n    \\\"understated\\\"\\n  ],\\n  \\\"hard_exclusions\\\": {\\n    \\\"tags\\\": [],\\n    \\\"terms\\\": [\\n      \\\"巧克力\\\"\\n    ],\\n    \\\"unresolved\\\": []\\n  },\\n  \\\"additional_context\\\": \\\"完全虚构的现场演示请求。评委临时指定禁忌词：不要任何巧克力相关。追求对象默认低压力表达，不假定对方心意或已有双向好感。\\\"\\n}\",\"trusted_repair_count\":0,\"sys.files\":[],\"sys.user_id\":\"8fb7e7d7-34b8-4a7d-9523-bae8faebd212\",\"sys.app_id\":\"5abdb13c-a633-4a9c-96c3-dabd44072511\",\"sys.workflow_id\":\"095b12b9-6cea-48b1-aa47-88473b91f30d\",\"sys.workflow_run_id\":\"fcc5419a-98b9-40d4-bb83-29c8b01f6620\"},\"created_at\":1793372807,\"reason\":\"initial\"}}\n\ndata: {\"event\":\"node_started\",\"workflow_run_id\":\"fcc5419a-98b9-40d4-bb83-29c8b01f6620\",\"task_id\":\"f3b2bcb1-5dee-4a5a-8dad-29fc8438b5e6\",\"data\":{\"id\":\"8ee370f5-0ee5-42a1-b6