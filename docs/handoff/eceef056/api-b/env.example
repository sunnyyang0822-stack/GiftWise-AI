# 【实测=源码核查】代码 eceef056ce80399b83c61f62860a32d0ead16e3d；不读取或复制任何实际.env。
# 非秘密模板，不是可直接上线的完整环境。应用不会自动加载此文件。
# https://github.com/sunnyyang0822-stack/GiftWise-AI/blob/eceef056ce80399b83c61f62860a32d0ead16e3d/web/server/config.mjs#L98
GW_MODE=llm
# 【推算】跨容器监听示例，代码默认127.0.0.1；目标反代/公网权限另定。
GW_HOST=0.0.0.0
GW_PORT=8787
# 【未测】部署侧通过秘密系统注入；此处不含任何真实凭据或令牌值。
# 三项缺一，GW_MODE=llm仍可能回落mock；启动器必须先检查非空并核对有效mode。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 【实测=源码核查】以下为未设变量时的代码默认值，均非整体SLA。
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_OUTPUT_RETRIES=1
LLM_MAX_TOKENS=16384
LLM_PARSE_MAX_TOKENS=8192
LLM_TEMPERATURE=0.4
# LLM_CALL_BUDGET故意不赋值：未设才是null/无限制；空串会转为0并阻止调用。
GIFTWISE_INTAKE_PARSE=1
# 【推算】交接保留选后AI图；=1还需有效IMAGE_API_KEY、合法选择与呈现通过。
# https://github.com/sunnyyang0822-stack/GiftWise-AI/blob/eceef056ce80399b83c61f62860a32d0ead16e3d/web/server/config.mjs#L319
GIFTWISE_IMAGE_GENERATION=1
IMAGE_API_KEY=
# 【实测=源码核查】当前主参考路径为HTTP文字，保留domestic能力。
GIFTWISE_RETRIEVAL=domestic
# 【推算】示例相对仓库根；部署侧应改为本部署项目内独立绝对路径，详见C迁移材料。
GW_LOCAL_DB=./.tmp/deploy/catalog.sqlite
GW_LLM_LEDGER_FILE=./.tmp/deploy/llm-ledger.jsonl
# 【未测】仅点评等浏览器能力需要时配置；不搬个人登录态。
# OPENCLI_PACKAGE_ROOT=
# GW_OPENCLI_MAIN=
# GW_CHROME_PATH=
# GW_DOMESTIC_PROFILE=./.tmp/deploy/dianping-profile
# GW_DOMESTIC_HEADLESS=1
# 不用?preview=1做生产验收；不设NODE_TEST_CONTEXT/GW_LLM_TEST_MODE/真实账本reset。
# GIFTWISE_PRESENTATION_WAIT_MS仍有遗留读取，但不控制本版选后等图；DIFY_*非主链。
