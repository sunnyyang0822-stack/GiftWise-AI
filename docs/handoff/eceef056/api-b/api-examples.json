            "status": "pending",
            "image": null
          }
        },
        "media_wait": {
          "waited": false,
          "timed_out": false,
          "waited_ms": 0,
          "timeout_ms": 0,
          "task_id": "<task_id>"
        }
      },
      "notes": [
