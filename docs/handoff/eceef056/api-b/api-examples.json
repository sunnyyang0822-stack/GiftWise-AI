        },
        {
          "method": "GET",
          "path": "/api/media/tasks/<task_id>"
        },
        {
          "method": "GET",
          "path": "/api/media/assets/<task_id>"
        }
      ],
      "response_shape_example": {
        "run_snapshot": {
          "recommendation_run_id": "<run_id>",
          "selected_candidate_id": "<candidate_id>",
          "selectable_candidate_ids": "<array>",
          "status": "<server_run_status>",
          "media": "<object>"
        },
        "task_pending": {
          "contract_version": "retrieval-media-v2",
          "status": "pending",
          "selected": {
            "task_id": "<task_id>",
            "candidate_id": "<candidate_id>",
            "status": "pending",
            "image": null
          }
        },
        "task_ready": {
          "status": "ready",
          "selected": {
            "task_id": "<task_id>",
            "status": "ready",
            "execution": "succeeded",
            "image": {
              "id": "<asset_sha>",
              "url": "/api/media/assets/<task_id>",
              "kind": "ai_illustration"
            },
            "appearance_consistency": "not_verified"
          }
        },
        "task_failed_execution_unknown": {
          "status": "failed",
          "selected": {
            "task_id": "<task_id>",
            "status": "failed",
            "execution": "unknown",
            "image": null,
            "error_code": "<IMAGE_*实际错误码>"
          }
        },
        "asset_ready": {
          "http_status": 200,
          "body_kind": "图片字节，不是JSON",
          "cache_control": "private, no-store"
        },
        "media_not_found": {
          "http_status": 404,
          "body": {
            "status": "error",
            "errors": [
              {
                "code": "MEDIA_NOT_FOUND",
                "message": "图片任务不存在、未就绪或不属于当前会话。"
              }
            ]
          }
        }
      },
      "notes": [
        "ready示意不是图片生成证据；task GET只读取，不提交或重试生图。asset路径使用task_id，不是image.id/文件hash。",
        "未授权/未配置的unavailable响应可能带task_id但没有持久化任务，此时task GET404是代码设计。",
        "读任务和图片需有效同owner/run及当前选中候选；重启/TTL可能404。失败/超时不能证明供应商未执行或未计费。"
