1200" height="21" as="geometry" /></mxCell><mxCell id="t-foot" value="运维通道：OpenCLI 仅用于部署操作，不在用户请求链路　·　推荐阶段不抓取网图　·　部署 19b6819 · 证据 6e92a9e" style="text;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="28" y="777" width="1200" height="21" as="geometry" /></mxCell><mxCell id="input" value="&lt;b&gt;需求输入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;自然描述 · 排除项确认&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="250" height="92" as="geometry" /></mxCell><mxCell id="compare" value="&lt;b&gt;三方案比较&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;依据 · 估价 · 校验结果&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;推荐卡不配网图&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="590" y="66" width="240" height="92" as="geometry" /></mxCell><mxCell id="select" value="&lt;b&gt;用户明确选择&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;只能选通过检查的方案&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="850" y="66" width="240" height="92" as="geometry" /></mxCell><mxCell id="guide" value="&lt;b&gt;赠送指南与效果图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;文字先展示 · 图片原位补入&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;纯体验不强加包装章节&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1110" y="66" width="300" height="92" as="geometry" /></mxCell><mxCell id="parse" value="&lt;b&gt;解析与可信上下文&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;自然澄清 · 保留原话&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;服务端固定已确认约束&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="30" y="256" width="250" height="108" as="geometry" /></mxCell><mxCell id="cand" value="&lt;b&gt;候选生成&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;模型按需调用检索工具&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;公开文字依据 → 三方案&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="300" y="256" width="270" height="108" as="geometry" /></mxCell><mxCell id="check" value="&lt;b&gt;独立代码校验&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;预算 · 禁忌 · 结构&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;时间不影响可选性&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="590" y="256" width="240" height="108" as="geometry" /></mxCell><mxCell id="post" value="&lt;b&gt;选择后生成与复核&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;包装 · 配色 · 贺卡 · 赠送&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;全局最多一次业务修订&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="850" y="256" width="240" height="108" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;文字响应与媒体任务 API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;立即返回文字 + task_id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;只读 GET 状态与图片 · 归属校验&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1110" y="256" width="300" height="108" as="geometry" /></mxCell><mxCell id="mem" value="&lt;b&gt;内存状态&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;run · analysis · selection · 签名&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;重启后旧流程失效&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="30" y="452" width="250" height="112" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;独立数据库&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;/var/lib/giftwise/db&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;独立 SQLite · 不用演示库&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="590" y="452" width="240" height="112" as="geometry" /></mxCell><mxCell id="runtime" value="&lt;b&gt;独立落盘 runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;/var/lib/giftwise/runtime&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;文字缓存 · 媒体 · 审计 · 账本&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="850" y="452" width="240" height="112" as="geometry" /></mxCell><mxCell id="img" value="&lt;b&gt;后台效果图任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;仅为所选方案生成 1 张&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;pending → ready / failed / unknown&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1110" y="452" width="300" height="112" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;公开文字检索 · 匿名 HTTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;真实公开文字 + 合法历史摘要&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;保留观察时间&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="270" height="104" as="geometry" /></mxCell><mxCell id="llm" value="&lt;b&gt;文字模型 API · HTTPS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;解析 · 三方案 · 修订 · 赠送指南&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&